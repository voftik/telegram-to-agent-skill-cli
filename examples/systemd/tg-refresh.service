[Unit]
Description=tg-cli refresh local Telegram cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Credentials come from the protected data-dir .env (0600) which the CLI
# loads itself — do NOT inline TG_API_ID/TG_API_HASH here: unit files are
# world-readable.
ExecStart=%h/.local/bin/tg refresh --yaml
# Output goes to the systemd journal (private per-user) — no /tmp logs.
